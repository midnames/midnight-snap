{
  "version": "0.9.0",
  "description": "Midnight wallet inside MetaMask: keys, sync, transfers, dApp connector",
  "proposedName": "Midnight Snap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnames/midnight-snap.git"
  },
  "source": {
    "shasum": "Dtsv1YxMybw+dhX+FS4pvQaRmrzMib+Rjuz2ZEh/d+s=",
    "location": {
      "npm": {
        "filePath": "dist/bundle.js",
        "packageName": "@midnames/midnight-snap",
        "registry": "https://registry.npmjs.org/"
      }
    }
  },
  "initialPermissions": {
    "snap_dialog": {},
    "snap_manageState": {},
    "snap_notify": {},
    "snap_getBip32Entropy": [
      {
        "path": ["m", "44'", "2400'"],
        "curve": "secp256k1"
      }
    ],
    "endowment:rpc": {
      "dapps": true,
      "snaps": false,
      "maxRequestTime": 180000
    },
    "endowment:network-access": {},
    "endowment:webassembly": {},
    "endowment:cronjob": {
      "jobs": [
        {
          "expression": "*/5 * * * *",
          "request": {
            "method": "backgroundSync"
          }
        }
      ]
    },
    "endowment:page-home": {}
  },
  "platformVersion": "12.0.0",
  "manifestVersion": "0.1"
}
