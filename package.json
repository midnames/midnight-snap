{
  "name": "@midnames/midnight-snap",
  "version": "0.9.0",
  "description": "Midnight wallet inside MetaMask: keys, sync, transfers, dApp connector",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnames/midnight-snap.git"
  },
  "main": "dist/bundle.js",
  "files": [
    "dist/",
    "snap.manifest.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "mm-snap build",
    "build:dev": "SNAP_DEV_RPC=1 mm-snap build",
    "serve": "mm-snap serve",
    "watch": "SNAP_DEV_RPC=1 mm-snap watch",
    "test": "SNAP_DEV_RPC=1 mm-snap build && jest",
    "check:fastsync": "node scripts/check-fastsync.mjs",
    "prepublishOnly": "test -n \"$SNAP_WALLET_ORIGIN\" || { echo 'Set SNAP_WALLET_ORIGIN to the wallet site origin' >&2; exit 1; } && mm-snap build"
  },
  "dependencies": {
    "@metamask/snaps-sdk": "12.0.0",
    "@midnight-ntwrk/zkir-v2": "2.1.0",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0-beta.0",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-dust-wallet": "5.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-facade": "5.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-hd": "3.0.3",
    "@midnightntwrk/wallet-sdk-shielded": "4.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "4.0.0-beta.2",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "effect": "3.22.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@metamask/snaps-cli": "8.4.1",
    "@metamask/snaps-jest": "^10.2.1",
    "@swc/jest": "^0.2.39",
    "jest": "^29.7.0",
    "typescript": "5.9.2",
    "webpack": "^5.110.3"
  }
}
